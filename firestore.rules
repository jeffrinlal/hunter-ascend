rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════════════
    // HUNTERS COLLECTION
    // ══════════════════════════════════════════════════════════════════════
    match /hunters/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId;
      // Required by anonymous logout: the guest user deletes their own
      // hunter document before deleting the auth account.
      allow delete: if request.auth != null
                    && request.auth.uid == userId;

      // ── Rank Rewards (permanent, one-time-only grants) ──
      // create-only: a second create for the same rewardId is structurally
      // rejected (doc already exists → evaluated as update → denied).
      match /rankRewards/{rewardId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
        allow delete: if false;
      }

      // ── Unlocked Achievements (permanent claims + XP-award flag) ──
      // create: claim an achievement once.
      // update: ONLY flip xpAwarded false→true (crash recovery).
      // delete: ONLY while xpAwarded is still false (rollback on XP failure).
      match /unlockedAchievements/{achievementId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && resource.data.xpAwarded == false
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xpAwarded'])
                      && request.resource.data.xpAwarded == true;
        allow delete: if request.auth != null
                      && request.auth.uid == userId
                      && resource.data.xpAwarded == false;
      }

      // ── Equipped Rewards (mutable cosmetic selection) ──
      match /equippedRewards/{docId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // HUNTER NAMES
    // ══════════════════════════════════════════════════════════════════════
    match /hunterNames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════
    // DUEL REQUESTS
    // ══════════════════════════════════════════════════════════════════════
    match /duel_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.toUid == request.auth.uid;
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════
    // DUELS
    // ══════════════════════════════════════════════════════════════════════
    match /duels/{duelId} {
      allow read, write: if request.auth != null;
    }

    // ══════════════════════════════════════════════════════════════════════
    // CUSTOM QUESTS
    // ══════════════════════════════════════════════════════════════════════
    match /custom_quests/{questId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
                            && resource.data.uid == request.auth.uid;
    }

    // ══════════════════════════════════════════════════════════════════════
    // WEIGHT HISTORY
    // ══════════════════════════════════════════════════════════════════════
    match /weight_history/{historyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════
    // RUNS
    // ══════════════════════════════════════════════════════════════════════
    match /runs/{runId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
                            && resource.data.uid == request.auth.uid;
    }

    // ══════════════════════════════════════════════════════════════════════
    // CALORIE LOGS
    // ══════════════════════════════════════════════════════════════════════
    match /calorie_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // ══════════════════════════════════════════════════════════════════════
    // APP CONFIG (read-only)
    // ══════════════════════════════════════════════════════════════════════
    match /app_config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════════════════════
    // SETTINGS (read-only)
    // ══════════════════════════════════════════════════════════════════════
    match /settings/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════════════════════
    // DEFAULT: deny everything else
    // ══════════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
