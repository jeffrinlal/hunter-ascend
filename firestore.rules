rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════════════
    // HUNTERS COLLECTION
    // ══════════════════════════════════════════════════════════════════════
    //
    // Each hunter document is at: hunters/{uid}
    //
    // SECURITY PRINCIPLE:
    // - Users can only read and write their own document.
    // - Updates are restricted: each write may only touch fields relevant
    //   to that operation.
    // - Membership fields are writable by the owner ONLY via a dedicated
    //   rule that limits affected keys to membership-related fields.
    // - Gameplay fields are writable by the owner but CANNOT touch
    //   membership fields in the same write.
    // - Cross-user duel stat writes are temporarily allowed (deferred item).
    // ══════════════════════════════════════════════════════════════════════

    match /hunters/{hunterId} {

      // ── Read: only the document owner ──
      allow read: if request.auth != null && request.auth.uid == hunterId;

      // ── Create: only the document owner ──
      allow create: if request.auth != null
                    && request.auth.uid == hunterId;

      // ── Update: restricted by field sets ──
      allow update: if request.auth != null
                    && (
                      // ── Own document: gameplay fields ──
                      // Allows updating any field EXCEPT membership fields.
                      (request.auth.uid == hunterId
                       && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                         'membershipType',
                         'membershipExpiry',
                         'pendingMaxRewardAds',
                         'pendingMaxRewardStartedAt',
                         'lastRewardClaim'
                       ]))
                      ||
                      // ── Own document: membership reward claim ──
                      // Allows updating ONLY membership-related fields.
                      (request.auth.uid == hunterId
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'membershipType',
                         'membershipExpiry',
                         'pendingMaxRewardAds',
                         'pendingMaxRewardStartedAt',
                         'lastRewardClaim'
                       ]))
                      ||
                      // ── Cross-user: duel stats only (temporary) ──
                      (request.auth.uid != hunterId
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'duelWins', 'duelLosses'
                       ]))
                    );

      // ── Delete: never allowed from client ──
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════
    // SUBSCRIPTIONS COLLECTION (legacy — locked)
    // ══════════════════════════════════════════════════════════════════════
    match /subscriptions/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════════════════════
    // DUELS COLLECTION
    // ══════════════════════════════════════════════════════════════════════
    match /duels/{duelId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════════
    // DEFAULT: deny everything else
    // ══════════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
