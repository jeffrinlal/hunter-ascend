# Hunter Ascend — Cloud Functions Environment Configuration
#
# Copy this file to .env and fill in production values.
# .env is loaded automatically by Firebase Functions at deploy time.
# Do NOT commit .env to source control (it's in .gitignore).

# Android package name registered in Google Play Console.
PLAY_PACKAGE_NAME=com.hunterascend.hunter_ascend

# Cloud Pub/Sub topic for Google Play Real-Time Developer Notifications.
# Must match the topic configured in Google Play Console under
# Monetization → Monetization Setup → Real-time developer notifications.
RTDN_TOPIC=play-rtdn

# JSON mapping of Google Play subscription product IDs to logical plans.
# Keys = product IDs from Google Play Console.
# Values = membership tier names stored in Firestore ("pro" or "max").
PRODUCT_MAP={"com.hunterascend.pro_monthly":"pro","com.hunterascend.max_monthly":"max"}
